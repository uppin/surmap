<?xml version="1.0" encoding="UTF-8"?>
<!-- Fictional civilian earthquake-and-flood block for SurMap search and rescue.
     Original SDF primitives and procedural textures. Not a real incident.
     The world name matches the file PX4 opens: disaster_block.sdf.
     Spherical coordinates are the PX4 SITL anchor so the compass matches.
     Licences and the WSL2 launch are in docs/simulation/disaster-world.md. -->
<sdf version="1.9">
  <world name="disaster_block">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter" />
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <grid>false</grid>
      <ambient>0.42 0.40 0.38 1</ambient>
      <background>0.55 0.58 0.62 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <intensity>1.05</intensity>
      <direction>0.40 0.25 -0.88</direction>
      <diffuse>1.0 0.93 0.82 1</diffuse>
      <specular>0.25 0.22 0.18 1</specular>
      <attenuation>
        <range>2000</range>
        <constant>1</constant>
        <linear>0</linear>
        <quadratic>0</quadratic>
      </attenuation>
    </light>
    <light name="fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <intensity>0.28</intensity>
      <direction>-0.4 -0.3 -0.85</direction>
      <diffuse>0.55 0.58 0.62 1</diffuse>
      <specular>0.02 0.02 0.02 1</specular>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>488</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <model name="ground_plane">
