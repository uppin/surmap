<?xml version="1.0" encoding="UTF-8"?>
<!-- Fictional civilian earthquake-and-flood block for SurMap search and rescue.
     Original SDF primitives and procedural textures. Not a real incident.
     The world name matches the file PX4 opens: disaster_block.sdf.
     Spherical coordinates are the PX4 SITL anchor so the compass matches.
     Licences and the WSL2 launch are in docs/simulation/disaster-world.md. -->
<sdf version="1.9">
  <world name="disaster_block">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <grid>false</grid>
      <ambient>0.48 0.50 0.52 1</ambient>
      <background>0.53 0.70 0.90 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <intensity>1.1</intensity>
      <direction>0.35 0.42 -0.84</direction>
      <diffuse>1.0 0.95 0.86 1</diffuse>
      <specular>0.32 0.30 0.26 1</specular>
