<?xml version="1.0" encoding="UTF-8"?>
<!-- x500 + SurMap stereo. Launch with PX4_GZ_MODEL_NAME=x500_surmap_stereo
     (or spawn this model) after adding docs/simulation/gz to GZ_SIM_RESOURCE_PATH.
-->
<sdf version="1.9">
  <model name="x500_surmap_stereo">
    <include merge="true">
      <uri>x500</uri>
    </include>
    <include merge="true">
      <uri>model://surmap_stereo_cam</uri>
      <pose>0.12 0 0.242 0 0 0</pose>
    </include>
    <joint name="SurmapStereoJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0.12 0 0.242 0 0 0</pose>
    </joint>
  </model>
</sdf>
