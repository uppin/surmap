[Unit]
Description=SurMap CM5 survey server (Cm5SurveyService)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=surmap
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/.venv/bin/python -m surmap.survey.cm5_main --host 0.0.0.0 --port @PORT@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
