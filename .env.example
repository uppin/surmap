# Copy to `.env` (git-ignored). Loaded via surmap.env.load_env() by `python -m surmap.agent`,
# `python -m surmap.mapqa`, scripts/demo.py, scripts/mission_demo.py and the Muse / Fireworks
# live tests. The real environment always wins over this file; values are never logged.

# Hugging Face token for gated checkpoints, e.g. facebook/sam3.1
HF_TOKEN=

# Default SAM model for scripts/demo.py --sam-device (path or model id)
SURMAP_SAM_MODEL=

# Meta Model API key: Muse for the survey agent (meta:<model>), Ask the map and the mission demo
MODEL_API_KEY=

# Fireworks API key: lists and builds the survey agent's fireworks:<model> ids
FIREWORKS_API_KEY=

# Optional: the agent's Muse model (default muse-wonder-1.0)
SURMAP_AGENT_META_MODEL=

# Optional: Fireworks base URL (default https://api.fireworks.ai/inference/v1; https or loopback http)
SURMAP_FIREWORKS_URL=

# Optional: comma-separated Fireworks model ids to list instead of asking GET /models
SURMAP_FIREWORKS_MODELS=

# Optional: Ollama server (default http://127.0.0.1:11434)
SURMAP_OLLAMA_URL=

# Optional: Ollama model for the local live paths (see `ollama list`)
SURMAP_OLLAMA_MODEL=
