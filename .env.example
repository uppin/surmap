# Copy to `.env` (git-ignored, loaded by scripts/demo.py via surmap.env).
# The real environment always wins over this file; values are never logged.

# Hugging Face token for gated checkpoints, e.g. facebook/sam3.1
HF_TOKEN=

# Default SAM model for scripts/demo.py --sam-device (path or model id)
SURMAP_SAM_MODEL=
